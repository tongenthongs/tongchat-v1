# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_POCKETBASE_URL: Public URL of your PocketBase backend (e.g. https://pb.entong.site)
VITE_POCKETBASE_URL="https://pb.entong.site"

# DISCORD_BOT_TOKEN: Discord Bot Token for listening to DDS Script updates in Discord channels
DISCORD_BOT_TOKEN=""

# RESEND_API_KEY: Resend Transactional Email Service API Key (e.g. re_xxxx)
RESEND_API_KEY=""

# SMTP Configuration (Alternative to Resend, e.g. Brevo, Google Workspace, Custom Mail Server)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Official Sender and Reply-To addresses for high deliverability
EMAIL_FROM="Entong Store <noreply@entongstore.com>"
EMAIL_REPLY_TO="support@entongstore.com"

# Cloudflare Turnstile Site Key
VITE_CLOUDFLARE_SITE_KEY=""
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=""

# WhatsApp Gateway Service Configuration (Fonnte / Wablas / Custom Webhook)
FONNTE_TOKEN=""
WABLAS_TOKEN=""
WABLAS_SERVER="https://jogja.wablas.com"
WHATSAPP_GATEWAY_URL=""
WHATSAPP_API_KEY=""

